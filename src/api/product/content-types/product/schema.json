{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "part_number": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "retail": {
      "type": "decimal",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image_link": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "currency": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "additional_images": {
      "displayName": "Images",
      "type": "component",
      "repeatable": true,
      "component": "images.images",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "product_types": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-type.product-type",
      "mappedBy": "products"
    },
    "subcategory": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::subcategory.subcategory"
    },
    "params": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "discount": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cart_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cart-item.cart-item",
      "mappedBy": "product"
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "salesCount": {
      "type": "integer",
      "required": false,
      "default": 0,
      "unique": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "favorite_products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::favorite-product.favorite-product",
      "mappedBy": "product"
    },
    "langMatches": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "json",
      "required": false
    },
    "lastPriceUpdatedAt": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "datetime"
    },
    "product_parameters": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-parameter.product-parameter",
      "mappedBy": "product"
    }
  }
}
