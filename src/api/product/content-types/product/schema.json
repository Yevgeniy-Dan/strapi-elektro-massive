{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "part_number": {
      "type": "string",
      "required": true
    },
    "retail": {
      "type": "decimal",
      "required": true
    },
    "image_link": {
      "type": "string"
    },
    "params": {
      "displayName": "parameters",
      "type": "component",
      "repeatable": true,
      "component": "product-parameter.parameters"
    },
    "currency": {
      "type": "string",
      "required": true
    },
    "additional_images": {
      "displayName": "Images",
      "type": "component",
      "repeatable": true,
      "component": "images.images"
    },
    "product_types": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-type.product-type",
      "mappedBy": "products"
    },
    "subcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subcategory.subcategory",
      "inversedBy": "products"
    }
  }
}
